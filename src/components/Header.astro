---
import Logo from './Logo.astro';
---
<header class="absolute inset-x-0 top-0 z-40 border-b border-white/15 bg-[rgba(15,31,24,.22)] text-white backdrop-blur-md">
  <div class="container-site flex h-20 items-center justify-between gap-4">
    <Logo inverse />
    <nav class="hidden items-center gap-6 text-sm font-bold lg:flex" aria-label="التنقل الرئيسي">
      <a class="text-white/95 transition hover:text-white" href="#about">عن الغابة</a>
      <a class="text-white/95 transition hover:text-white" href="#plan">خطط للزيارة</a>
      <a class="text-white/95 transition hover:text-white" href="#transport">الوصول</a>
      <a class="text-white/95 transition hover:text-white" href="#facilities">الخدمات</a>
      <a class="text-white/95 transition hover:text-white" href="#faq">الأسئلة الشائعة</a>
    </nav>
    <a href="#map" class="rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-black text-white transition hover:bg-white hover:text-[var(--forest-950)]">الخريطة</a>
  </div>
</header>
