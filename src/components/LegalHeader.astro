---
import Logo from './Logo.astro';
import { altPair } from '../data/guide';

const isEn = Astro.url.pathname.startsWith('/en');
const alt = altPair(Astro.url.pathname);
const back = isEn ? '/en/' : '/';
const backLabel = isEn ? 'Back to the guide' : 'العودة إلى دليل الغابة';
const toggleLabel = isEn ? 'العربية' : 'English';
---
<header class="border-b border-[var(--line)] bg-white/75 backdrop-blur">
  <div class="container-site flex min-h-20 items-center justify-between gap-4 py-3">
    <Logo />
    <div class="flex items-center gap-3">
      <a href={back} class="rounded-full border border-[var(--line)] px-4 py-2 text-sm font-black text-[var(--forest-800)] hover:bg-[var(--mist-100)]">{backLabel}</a>
      <a href={isEn ? alt.ar : alt.en} class="rounded-full bg-[var(--forest-800)] px-4 py-2 text-sm font-black text-white hover:bg-[var(--forest-700)]">{toggleLabel}</a>
    </div>
  </div>
</header>
