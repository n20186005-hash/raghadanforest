---
interface Props {
  lat: string;
  lon: string;
  lang?: 'ar' | 'en';
}
const { lat, lon, lang = 'ar' } = Astro.props;
const isEn = lang === 'en';
const H = isEn
  ? {
      eyebrow: 'Weather model',
      title: 'Conditions and the coming days',
      lead: 'An updated weather glance to help you choose clothes and the right time to visit. The mountain setting can change visibility and the view within a few hours, so treat the forecast as a planning tool, not a guarantee.'
    }
  : {
      eyebrow: 'نموذج الطقس',
      title: 'الحالة الجوية وتوقعات الأيام القادمة',
      lead: 'لمحة جوية محدّثة تساعدك على اختيار الملابس والوقت المناسب للزيارة. الطابع الجبلي للموقع قد يغيّر الرؤية والإطلالة خلال ساعات قليلة، لذلك تعامل مع التوقعات كأداة تخطيط لا كضمان.'
    };
---
{/* @ts-nocheck */}
<section id="weather" class="section-space bg-[var(--mist-100)]">
  <div class="container-site">
    <div class="max-w-3xl">
      <span class="eyebrow">{H.eyebrow}</span>
      <h2 class="section-title">{H.title}</h2>
      <p class="section-lead">{H.lead}</p>
    </div>

    <div id="weather-widget" class="mt-10" data-lat={lat} data-lon={lon} data-lang={lang}>
      <div class="rounded-[2rem] border border-[var(--line)] bg-white/70 p-8 text-center text-[var(--muted)]" id="weather-loading">
        {isEn ? 'Loading current weather…' : 'جارٍ تحميل الحالة الجوية…'}
      </div>
    </div>
  </div>
  <p class="container-site pb-8 text-sm"><a class="underline" href="https://open-meteo.com/">Open-Meteo</a> · <a class="underline" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · <a class="underline" href="https://ncm.gov.sa/">{isEn ? 'Official warnings: NCM' : 'التنبيهات الرسمية: المركز الوطني للأرصاد'}</a></p>
</section>

<script is:inline type="module" src="/weather.js"></script>
