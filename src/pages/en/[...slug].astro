---
import TopicPage from '../../components/TopicPage.astro';
import { TOPICS } from '../../data/topics';

export function getStaticPaths() {
  return TOPICS.map((t) => ({
    params: { slug: t.slug },
    props: { slug: t.slug }
  }));
}

const { slug } = Astro.props;
---

<TopicPage lang="en" slug={slug} />
