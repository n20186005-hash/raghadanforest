---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const mapUrl = 'https://maps.app.goo.gl/fWTXPEcNSYzMdcmRA';
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6672.45030720732!2d41.4334279!3d20.0220551!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x15ef4f6655951595%3A0x79af6e771103498b!2sRaghadan%20Forest%20Park!5e1!3m2!1sar!2ssa!4v1787707688232!5m2!1sar!2ssa';

const photos = {
  entrance: 'https://upload.wikimedia.org/wikipedia/commons/c/c5/%D9%85%D9%86%D8%AA%D8%B2%D9%87_%D8%BA%D8%A7%D8%A8%D8%A9_%D8%B1%D8%BA%D8%AF%D8%A7%D9%861W9828.jpg',
  sign: 'https://upload.wikimedia.org/wikipedia/commons/4/44/Welcome_Sign_-_Raghdan_Forest_1.jpg',
  ridge: 'https://upload.wikimedia.org/wikipedia/commons/b/b7/Albaha9021_-_1.jpeg',
  forest: 'https://upload.wikimedia.org/wikipedia/commons/e/e0/Albaha9021_-_2.jpeg',
  clouds: 'https://upload.wikimedia.org/wikipedia/commons/4/46/%D8%A7%D9%84%D8%A8%D8%A7%D8%AD%D8%A9_-_1.jpeg'
};

const faqItems = [
  {
    q: 'هل دخول غابة رغدان يحتاج إلى تذكرة؟',
    a: 'تفيد صفحة «روح السعودية» بأن الدخول العام إلى الغابة لا يحتاج إلى تذكرة. قد تكون لبعض الفعاليات أو الأنشطة والخدمات الموسمية رسوم مستقلة، لذلك تحقّق من الإعلان الرسمي عند وجود فعالية.'
  },
  {
    q: 'ما ساعات فتح غابة رغدان؟',
    a: 'تورد «روح السعودية» ساعات يومية من 8:00 صباحاً حتى 11:59 مساءً. لأن التشغيل قد يتغير في المواسم أو بسبب الطقس والصيانة، يُفضّل التحقق من القنوات الرسمية قبل الرحلة.'
  },
  {
    q: 'هل الغابة مناسبة للعائلات والأطفال؟',
    a: 'نعم؛ تشير بيانات أمانة المنطقة ووكالة الأنباء السعودية إلى مساحات خضراء ومناطق ألعاب وممرات ومقاعد وخدمات عامة. يبقى الإشراف المباشر على الأطفال ضرورياً بسبب طبيعة الموقع الجبلية والحواف والمنحدرات.'
  },
  {
    q: 'هل تتوفر دورات مياه ومواقف سيارات؟',
    a: 'بحسب بيانات منشورة في 2026، تضم الغابة 122 دورة مياه و1,230 موقفاً للمركبات، منها 42 موقفاً مهيأً لذوي الإعاقة. قد تتغير إتاحة بعض المرافق مؤقتاً بسبب الصيانة أو الازدحام.'
  },
  {
    q: 'ما أفضل وقت لزيارة غابة رغدان؟',
    a: 'الصباح الباكر مناسب للأجواء الهادئة وفرصة مشاهدة السحب إن تكوّنت، والعصر إلى ما قبل الغروب مناسب للإطلالات. الصيف أكثر ازدحاماً بسبب اعتدال أجواء الباحة، بينما يتطلب المطر والضباب قيادة ومشياً أكثر حذراً.'
  },
  {
    q: 'كم تستغرق الزيارة؟',
    a: 'للمشاهدة والمشي الهادئ، خصص عادةً من ساعتين إلى أربع ساعات. يمكن أن تمتد الزيارة إلى نصف يوم للعائلات أو للنزهة، بينما تكفي زيارة أقصر لمن يريد الإطلالة والتصوير فقط.'
  },
  {
    q: 'هل يمكن الوصول إلى الغابة بالحافلة؟',
    a: 'لا ينبغي الاعتماد على وجود خط حافلات ثابت يصل مباشرة إلى بوابة الغابة دون تحقق مسبق. يمكن الوصول إلى مدينة الباحة بوسائل نقل مختلفة، ثم إكمال الجزء الأخير بسيارة أو سيارة أجرة وفق الخدمة المتاحة وقت الرحلة.'
  },
  {
    q: 'هل ظهور الضباب مضمون؟',
    a: 'لا. الضباب والسحب المنخفضة من ملامح المشهد الشهيرة في رغدان، لكنها ظواهر جوية تتغير من ساعة إلى أخرى. لا تبنِ خطة الزيارة على ضمان ظهورها.'
  },
  {
    q: 'هل الموقع مناسب للكراسي المتحركة؟',
    a: 'توجد مواقف مخصصة لذوي الإعاقة وبعض المسارات والخدمات المطورة، لكن طبيعة الغابة جبلية وفيها فروق ارتفاع. راجع المسار المقصود عند الوصول، وفضّل المناطق المعبدة إذا كانت الحركة محدودة.'
  }
];

const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'غابة رغدان',
  alternateName: 'منتزه غابة رغدان',
  description: 'غابة جبلية ومتنزه عام على مرتفعات السروات غرب مدينة الباحة، تشتهر بأشجار العرعر والإطلالات على سهول تهامة والممرات والمساحات الخضراء.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '4657 الحكم الزروقي، 6905',
    addressLocality: 'الباحة',
    postalCode: '65731',
    addressCountry: 'SA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 20.0220551,
    longitude: 41.4334279
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '08:00',
    closes: '23:59'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.4,
    reviewCount: 40428,
    bestRating: 5
  },
  isAccessibleForFree: true,
  priceRange: 'الدخول العام بلا تذكرة',
  hasMap: mapUrl,
  image: [photos.entrance, photos.ridge, photos.clouds],
  sameAs: [mapUrl]
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};

const title = 'غابة رغدان في الباحة | دليل مستقل للزيارة والطبيعة والخدمات';
const description = 'دليل عربي مستقل غير ربحي إلى غابة رغدان في الباحة: الطبيعة والتاريخ، أوقات الزيارة، المواقف، دورات المياه، الوصول من المطار، الطعام والخدمات، الخريطة والأسئلة الشائعة.';
---
<BaseLayout title={title} description={description} structuredData={[attractionLd, faqLd]}>
  <Header />
  <main id="main-content">
    <section class="relative min-h-[92svh] overflow-hidden bg-[var(--forest-950)] text-white">
      <img src={photos.ridge} alt="جبال الباحة الخضراء والسحب حول مرتفعات السروات" class="absolute inset-0 h-full w-full object-cover opacity-60" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,27,20,.22),rgba(10,27,20,.82)_68%,rgba(10,27,20,.96))]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(17,37,29,.9),transparent_48%)]"></div>
      <div class="container-site relative flex min-h-[92svh] items-end pb-16 pt-32 lg:pb-20">
        <div class="grid w-full items-end gap-10 lg:grid-cols-[1.2fr_.8fr]">
          <div>
            <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold text-white/92 backdrop-blur">
              <span class="h-2 w-2 rounded-full bg-[var(--sand)]"></span>
              دليل مستقل غير ربحي · منطقة الباحة
            </div>
            <h1 class="max-w-4xl text-[clamp(3.4rem,10vw,8rem)] font-black leading-[.92] tracking-[-.065em]">غابة رغدان</h1>
            <p class="mt-7 max-w-2xl text-lg leading-9 text-white/95 lg:text-xl">
              عرعر السروات، ضباب تهامة، وممرات على حافة الغيم. دليل عملي لفهم المكان قبل أن تصل إليه، بلا إعلانات ولا توصيات تجارية مدفوعة.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#plan" class="rounded-full bg-white px-6 py-3 text-sm font-black text-black transition hover:-translate-y-0.5">خطط لزيارتك</a>
              <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 bg-white/10 px-6 py-3 text-sm font-black text-white transition hover:bg-white/20">افتح الموقع على الخريطة</a>
            </div>
          </div>
          <div class="glass-card rounded-[2rem] p-6 lg:p-7">
            <div class="grid grid-cols-2 gap-x-6 gap-y-7">
              <div>
                <p class="text-3xl font-black">+1,700 م</p>
                <p class="mt-1 text-xs text-white/90">ارتفاع تقريبي عن سطح البحر</p>
              </div>
              <div>
                <p class="text-3xl font-black">4.4 / 5</p>
                <p class="mt-1 text-xs text-white/90">تقييم خرائط جوجل المقدم للمشروع</p>
              </div>
              <div>
                <p class="text-3xl font-black">1,230</p>
                <p class="mt-1 text-xs text-white/90">موقفاً بحسب بيانات 2026</p>
              </div>
              <div>
                <p class="text-3xl font-black">دون تذكرة</p>
                <p class="mt-1 text-xs text-white/90">للدخول العام بحسب «روح السعودية»</p>
              </div>
            </div>
            <p class="mt-6 border-t border-white/15 pt-5 text-xs leading-6 text-white/85">
              المعلومات التشغيلية قابلة للتغيير. تحقق من الجهات الرسمية قبل السفر، خصوصاً أثناء المواسم والأمطار والصيانة.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="plan" class="relative z-10 -mt-7 pb-20">
      <div class="container-site">
        <div class="paper-card grid overflow-hidden rounded-[2rem] md:grid-cols-2 xl:grid-cols-4">
          <div class="border-b border-[var(--line)] p-6 md:border-l xl:border-b-0">
            <p class="text-xs font-black text-[var(--forest-700)]">الموقع</p>
            <p class="mt-2 font-black">غرب مدينة الباحة</p>
            <p class="mt-2 text-sm text-[var(--muted)]">على مرتفعات السروات المطلة على منحدرات تهامة.</p>
          </div>
          <div class="border-b border-[var(--line)] p-6 xl:border-b-0 xl:border-l">
            <p class="text-xs font-black text-[var(--forest-700)]">الساعات المنشورة</p>
            <p class="mt-2 font-black">8:00 ص — 11:59 م</p>
            <p class="mt-2 text-sm text-[var(--muted)]">يومياً وفق صفحة «روح السعودية»؛ تحقق قبل الذهاب.</p>
          </div>
          <div class="border-b border-[var(--line)] p-6 md:border-l md:border-b-0">
            <p class="text-xs font-black text-[var(--forest-700)]">المدة المقترحة</p>
            <p class="mt-2 font-black">2 — 4 ساعات</p>
            <p class="mt-2 text-sm text-[var(--muted)]">أطِلها إلى نصف يوم للنزهة العائلية والمشي الهادئ.</p>
          </div>
          <div class="p-6">
            <p class="text-xs font-black text-[var(--forest-700)]">أفضل إيقاع للزيارة</p>
            <p class="mt-2 font-black">صباحاً أو بعد العصر</p>
            <p class="mt-2 text-sm text-[var(--muted)]">للضوء اللطيف والهدوء؛ الضباب ظاهرة محتملة وليست مضمونة.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section-space pt-8">
      <div class="container-site">
        <div class="grid gap-12 lg:grid-cols-[.92fr_1.08fr] lg:items-center">
          <div>
            <span class="eyebrow">المشهد الطبيعي</span>
            <h2 class="section-title">غابة مرتفعة بين العرعر وحافة تهامة</h2>
            <p class="section-lead">
              تقع رغدان على جبال السروات إلى الغرب من مدينة الباحة، في نطاق يتجاوز ارتفاعه 1,700 متر تقريباً. الموقع ليس مجرد مساحة خضراء؛ إنه نقطة انتقال بصري بين قمم السروات والمنحدرات المتجهة نحو تهامة، ولهذا تبدو السحب المنخفضة والضباب جزءاً من شخصية المكان حين تسمح الظروف الجوية.
            </p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="rounded-[1.4rem] border border-[var(--line)] bg-white/65 p-5">
                <p class="font-black">أشجار العرعر</p>
                <p class="mt-2 text-sm text-[var(--muted)]">من أبرز مكونات الغطاء النباتي التقليدي في مرتفعات الباحة، وتمنح الغابة هويتها البصرية والبيئية.</p>
              </div>
              <div class="rounded-[1.4rem] border border-[var(--line)] bg-white/65 p-5">
                <p class="font-black">مساحة واسعة</p>
                <p class="mt-2 text-sm text-[var(--muted)]">تورد بيانات البلدية مساحة تقارب 482 ألف م²، فيما تشير مواد سياحية أقدم إلى نطاق أوسع؛ لذلك نعتمد الرقم البلدي الأحدث في الخدمات.</p>
              </div>
            </div>
          </div>
          <figure class="relative">
            <div class="absolute -inset-4 -z-10 translate-x-4 translate-y-4 rounded-[2.5rem] border border-[var(--line)]"></div>
            <img src={photos.entrance} alt="مدخل منتزه غابة رغدان في منطقة الباحة" loading="lazy" class="aspect-[4/3] w-full rounded-[2.3rem] object-cover shadow-[var(--shadow)]" />
            <figcaption class="mt-3 text-xs text-[var(--muted)]">مدخل الغابة في صورة مرخصة من ويكيميديا كومنز؛ تفاصيل الإسناد في قسم الصور والمصادر.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section-space bg-[var(--forest-950)] text-white">
      <div class="container-site">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
          <div>
            <span class="eyebrow !text-[var(--sand)]">خلفية المكان</span>
            <h2 class="section-title">اسمٌ مرتبط بالرخاء، ومشهدٌ أقدم من المتنزه الحديث</h2>
          </div>
          <div class="grid gap-7 text-white/92 md:grid-cols-2">
            <div>
              <p class="text-xl font-black text-white">رواية محلية عن الاسم</p>
              <p class="mt-3 text-sm leading-7">
                تنقل تغطيات محلية رواية شفوية تربط «رغدان» بمعنى رغد العيش ووفرة الماء والزراعة في الوادي والمدرجات المحيطة. نتعامل معها بوصفها رواية متداولة، لا تفسيراً لغوياً قاطعاً موثقاً بوثيقة تاريخية واحدة.
              </p>
            </div>
            <div>
              <p class="text-xl font-black text-white">السوق التاريخي</p>
              <p class="mt-3 text-sm leading-7">
                ارتبط اسم رغدان أيضاً بسوق تاريخي عُرف في المنطقة منذ قرون وكان ملتقى دورياً للسكان والتبادل. هذه الخلفية تساعد على فهم أن الموقع جزء من جغرافيا اجتماعية أوسع، لا نقطة تصوير منفصلة عن تاريخ الباحة.
              </p>
            </div>
            <div>
              <p class="text-xl font-black text-white">التطوير الحديث</p>
              <p class="mt-3 text-sm leading-7">
                أضيفت للموقع ممرات ومناطق جلوس وألعاب ومساحات مزروعة وعناصر مائية ومواقع مشاهدة، مع توسعات متتابعة تشمل «ممشى الغيم» وحديقة اللافندر ومشروعات تهيئة مرتبطة بالمطلّات.
              </p>
            </div>
            <div>
              <p class="text-xl font-black text-white">ما الذي يبقى طبيعياً؟</p>
              <p class="mt-3 text-sm leading-7">
                القيمة الأساسية تظل في التضاريس والعرعر والهواء الجبلي والإطلالة. تعامل مع التجهيزات كوسيلة للوصول إلى المشهد، لا بديلاً عنه، وحافظ على الغطاء النباتي بعدم الخروج إلى المناطق الحساسة أو ترك المخلفات.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space">
      <div class="container-site">
        <div class="max-w-3xl">
          <span class="eyebrow">ما الذي ستراه؟</span>
          <h2 class="section-title">تجربة تبدأ بالمشهد ثم تتفرع إلى المشي والاستراحة</h2>
          <p class="section-lead">لا توجد «نقطة واحدة» تختصر رغدان. الأفضل أن تتعامل معها كسلسلة من الإطلالات والمساحات المفتوحة والممرات، وتختار منها ما يناسب الوقت والقدرة على المشي.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['ممشى الغيم', 'ممر مرتفع ضمن تطوير الموقع، يبرز علاقة الغابة بالسحب والمنحدرات والإطلالة.'],
            ['حديقة اللافندر', 'جزء من أعمال التجميل والمشروعات الحديثة المحيطة بالمطلّات، وتختلف كثافة الزراعة حسب الموسم والصيانة.'],
            ['بهجة رغدان', 'منطقة مطورة تضم ممشى وعناصر مائية ومساحات عشبية ومناطق للأطفال والتصوير.'],
            ['الإطلالات الطبيعية', 'المكوّن الأكثر ثباتاً: السروات أمامك، وتهامة في الأسفل، والسحب بينهما حين تتشكل.']
          ].map(([name, text], index) => (
            <article class="group rounded-[1.6rem] border border-[var(--line)] bg-white/70 p-6 transition hover:-translate-y-1 hover:shadow-[var(--shadow)]">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--mist-100)] text-sm font-black text-[var(--forest-700)]">{String(index + 1).padStart(2, '0')}</div>
              <h3 class="mt-6 text-xl font-black">{name}</h3>
              <p class="mt-3 text-sm text-[var(--muted)]">{text}</p>
            </article>
          ))}
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <img src={photos.sign} alt="لوحة ترحيبية عند غابة رغدان" loading="lazy" class="aspect-[4/3] w-full rounded-[1.5rem] object-cover" />
          <img src={photos.forest} alt="طبيعة جبلية خضراء في منطقة الباحة" loading="lazy" class="aspect-[4/3] w-full rounded-[1.5rem] object-cover" />
          <img src={photos.clouds} alt="سحب وضباب فوق مرتفعات الباحة" loading="lazy" class="aspect-[4/3] w-full rounded-[1.5rem] object-cover" />
        </div>
      </div>
    </section>

    <section id="facilities" class="section-space border-y border-[var(--line)] bg-white/45">
      <div class="container-site">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
          <div class="lg:sticky lg:top-8 lg:self-start">
            <span class="eyebrow">الخدمات والمرافق</span>
            <h2 class="section-title">ما يحتاجه الزائر على الأرض</h2>
            <p class="section-lead">الأرقام التالية هي أحدث بيانات خدمية عامة وجدناها من الجهات المحلية في 2026. وجود المرفق لا يعني أن كل وحدة متاحة في كل لحظة، لذلك راعِ الصيانة والازدحام.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
