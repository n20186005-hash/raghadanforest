---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalHeader from '../components/LegalHeader.astro';
import Footer from '../components/Footer.astro';

const title = 'سياسة الخصوصية | دليل غابة رغدان';
const description = 'سياسة الخصوصية لمشروع دليل غابة رغدان المستقل غير الربحي.';
---
<BaseLayout title={title} description={description}>
  <LegalHeader />
  <main id="main-content" class="section-space">
    <article class="container-site max-w-4xl">
      <span class="eyebrow">الخصوصية والبيانات</span>
      <h1 class="section-title">سياسة الخصوصية</h1>
      <p class="text-sm font-bold text-[var(--forest-700)]">آخر تحديث: أغسطس 2026</p>
      <div class="prose-ar mt-10 rounded-[2rem] border border-[var(--line)] bg-white/75 p-6 shadow-[0_12px_40px_rgba(17,37,29,.05)] sm:p-9 lg:p-12">
        <p>
          يلتزم «دليل غابة رغدان» بمبدأ تقليل البيانات: لا ننشئ حسابات للمستخدمين، ولا نشغّل قاعدة بيانات للزوار، ولا نطلب بيانات شخصية لمجرد قراءة الدليل. قد تمر بعض البيانات التقنية الضرورية لتقديم الموقع أو عبر خدمات خارجية موضحة أدناه.
        </p>

        <h2>المعلومات التي قد تُجمع</h2>
        <ul>
          <li><strong>بيانات التصفح التقنية:</strong> مثل عنوان بروتوكول الإنترنت، نوع المتصفح، الجهاز، الصفحة المطلوبة، والتوقيت التقريبي للطلب. قد يعالج مزود الاستضافة هذه البيانات لأغراض التشغيل والأمان.</li>
          <li><strong>ملفات تعريف الارتباط أو التخزين المحلي:</strong> نستخدم تخزيناً محلياً لحفظ تفضيلات الموافقة، ويمكن تشغيل التحليلات فقط إذا فعّلتها من صفحة الإعدادات.</li>
          <li><strong>معلومات تقدمها طوعاً:</strong> لا توجد حالياً استمارة اتصال في الموقع. إذا أُضيفت وسيلة تواصل مستقبلاً، فلن نستخدم ما ترسله إلا للغرض الذي قدمته من أجله.</li>
        </ul>

        <h2>كيف نستخدم المعلومات</h2>
        <p>عندما تتوفر بيانات مشروعة وضرورية، يكون استخدامها محصوراً في الأغراض الآتية:</p>
        <ul>
          <li>تشغيل الموقع وحمايته وتحسين موثوقيته.</li>
          <li>فهم أنماط الاستخدام العامة وتحسين بنية المحتوى وتجربة القراءة، عند الموافقة على التحليلات.</li>
          <li>الاستجابة لطلب تواصل يقدمه المستخدم طوعاً إذا توفرت وسيلة تواصل.</li>
          <li>الامتثال للالتزامات القانونية الواجبة التطبيق.</li>
        </ul>

        <h2>الخدمات الخارجية</h2>
        <h3>خرائط جوجل</h3>
        <p>
          تتضمن الصفحة الرئيسية خريطة مضمّنة. عند تحميل الخريطة قد يتصل متصفحك بخوادم جوجل وترسل إليها بيانات تقنية وفق سياسات جوجل وشروطها. إذا كنت لا تريد تحميل الخريطة، يمكنك تجنب التمرير إلى قسم الخريطة أو استخدام إعدادات المتصفح المناسبة لحظر محتوى الطرف الثالث.
        </p>

        <h3>إحصاءات جوجل</h3>
        <p>
          نهيئ إحصاءات جوجل لقياس الزيارات، لكنها لا تُحمّل من هذا الموقع إلا بعد أن تختار تفعيل ملفات التحليل. يمكنك تغيير قرارك في أي وقت من صفحة «إعدادات ملفات تعريف الارتباط». نفعّل أيضاً خيار تقليل دقة عنوان الشبكة ضمن إعدادات القياس المتاحة.
        </p>

        <h3>ويكيميديا كومنز</h3>
        <p>
          تستخدم الصفحة الرئيسية عدداً محدوداً من الصور الفوتوغرافية المرخصة والمستضافة على ويكيميديا كومنز. عند تحميل هذه الصور قد يتصل متصفحك بخوادم ويكيميديا، وتخضع المعالجة التقنية لسياسات مؤسسة ويكيميديا. حقوق الصور تبقى لأصحابها وفق تراخيص كل ملف.
        </p>

        <h3>الاستضافة وشبكة التوصيل</h3>
        <p>
          صُمم المشروع للنشر على شبكة كلاودفلير. قد يعالج مزود الاستضافة سجلات تقنية أساسية لازمة لتوصيل المحتوى، الحد من إساءة الاستخدام، وتشخيص الأعطال، وفق شروطه وسياساته.
        </p>

        <h2>مدة الاحتفاظ</h2>
        <p>
          لا يحتفظ الموقع نفسه بملف مستخدم أو سجل زيارة في قاعدة بيانات. تفضيلات الموافقة تحفظ محلياً في متصفحك حتى تمسح بيانات الموقع أو تغيّر الإعداد. أما مدة احتفاظ مزودي الخدمات الخارجية فتخضع لإعداداتهم وسياساتهم.
        </p>

        <h2>حقوقك</h2>
        <p>وفق القوانين التي تنطبق عليك، ومنها اللائحة العامة لحماية البيانات عند انطباقها، قد تشمل حقوقك:</p>
        <ul>
          <li>طلب الوصول إلى بياناتك الشخصية.</li>
          <li>طلب تصحيح البيانات غير الدقيقة أو حذفها في الحالات التي يجيزها القانون.</li>
          <li>طلب تقييد بعض أوجه المعالجة أو الاعتراض عليها.</li>
          <li>سحب الموافقة على التحليلات في أي وقت دون التأثير في مشروعية المعالجة السابقة للسحب.</li>
          <li>تقديم شكوى إلى الجهة الرقابية المختصة إذا كان لك هذا الحق بموجب القانون المنطبق.</li>
        </ul>

        <h2>الأطفال</h2>
        <p>الموقع يقدم معلومات عامة عن معلم سياحي ولا يطلب عمداً بيانات شخصية من الأطفال. إذا أُضيفت مستقبلاً خدمة تتطلب بيانات، فستُراجع متطلبات العمر والموافقة قبل إطلاقها.</p>

        <h2>تغييرات هذه السياسة</h2>
        <p>قد نحدّث السياسة إذا تغيرت وظائف الموقع أو الخدمات التي يستخدمها. سيظهر شهر وسنة آخر تحديث في أعلى الصفحة، من دون اختلاق تواريخ مراجعة يومية لا يمكن التحقق منها.</p>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
