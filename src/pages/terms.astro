---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalHeader from '../components/LegalHeader.astro';
import Footer from '../components/Footer.astro';

const title = 'شروط الاستخدام | دليل غابة رغدان';
const description = 'شروط استخدام مشروع دليل غابة رغدان المستقل غير الربحي.';
---
<BaseLayout title={title} description={description}>
  <LegalHeader />
  <main id="main-content" class="section-space">
    <article class="container-site max-w-4xl">
      <span class="eyebrow">قواعد استخدام الدليل</span>
      <h1 class="section-title">شروط الاستخدام</h1>
      <p class="text-sm font-bold text-[var(--forest-700)]">آخر تحديث: أغسطس 2026</p>
      <div class="prose-ar mt-10 rounded-[2rem] border border-[var(--line)] bg-white/75 p-6 shadow-[0_12px_40px_rgba(17,37,29,.05)] sm:p-9 lg:p-12">
        <p>باستخدام هذا الموقع، فإنك توافق على هذه الشروط. إذا لم توافق عليها، يمكنك التوقف عن استخدام الموقع. هذه الشروط تخص الموقع نفسه ولا تمثل شروط دخول غابة رغدان أو أي جهة رسمية.</p>

        <h2>طبيعة المشروع</h2>
        <p>«دليل غابة رغدان» مشروع معلوماتي مستقل غير ربحي، وليس تابعاً لأمانة منطقة الباحة أو الهيئة السعودية للسياحة أو أي جهة حكومية أو مشغل تجاري. لا يبيع تذاكر، ولا يدير الحجوزات، ولا يتلقى عمولة مقابل توجيه الزوار إلى منشآت تجارية.</p>

        <h2>استخدام المحتوى</h2>
        <p>المعلومات المنشورة مخصصة للتثقيف والتخطيط العام للزيارة. يجوز لك قراءتها والاستفادة منها للاستخدام الشخصي المعتاد. لا يمنحك الموقع حق إعادة نشر النصوص الأصلية بكميات جوهرية أو نسبها إلى جهة أخرى دون إذن، مع مراعاة الحقوق التي يمنحها القانون مثل الاقتباس المشروع.</p>

        <h2>دقة المعلومات وتغيرها</h2>
        <p>نسعى إلى مقارنة المعلومات مع مصادر عامة موثوقة، لكن لا يمكن ضمان أن ساعات الفتح أو الرسوم أو حالة الطرق أو المرافق أو الفعاليات أو الطقس ستظل كما هي عند وصولك. تحقق من القنوات الرسمية قبل اتخاذ قرار سفر يعتمد على معلومة تشغيلية مهمة.</p>

        <h2>الطقس والسلامة</h2>
        <p>غابة رغدان موقع جبلي قد يشهد ضباباً أو أمطاراً أو انخفاضاً في الرؤية أو أسطحاً زلقة. المحتوى لا يُعد توجيهاً طارئاً أو بديلاً عن تعليمات الجهات المختصة واللافتات الميدانية. اتبع تعليمات السلامة المحلية دائماً.</p>

        <h2>الملكية الفكرية والصور</h2>
        <p>تصميم الموقع والنصوص التحريرية الأصلية محمية وفق الحقوق المطبقة. أما الصور الفوتوغرافية فحقوقها تعود إلى المصورين وأصحاب الحقوق، ويُستخدم كل ملف وفق الترخيص المبين له في ويكيميديا كومنز. لا يدعي المشروع ملكية صور الغير.</p>

        <h2>الخريطة والبيانات الخارجية</h2>
        <p>تُعرض خريطة جوجل المضمّنة وفق خدمات جوجل وشروطها. قد تؤدي الروابط إلى مواقع جهات رسمية أو مصادر خارجية لها شروطها وسياسات الخصوصية الخاصة بها. وجود الرابط لا يعني وجود شراكة أو اعتماد رسمي.</p>

        <h2>حدود المسؤولية</h2>
        <p>يُقدَّم الموقع «كما هو» لأغراض المعلومات العامة من دون ضمان صريح أو ضمني لاستمرار الخدمة أو كمال المحتوى. إلى الحد الذي يسمح به القانون، لا يتحمل المشروع مسؤولية خسائر ناشئة عن الاعتماد على معلومات متغيرة من دون التحقق من مصدرها الرسمي أو عن قرارات سفر يتخذها المستخدم بنفسه.</p>

        <h2>تحديث الشروط</h2>
        <p>قد تتغير هذه الشروط مع تطور المشروع أو إضافة خدمات جديدة. سيظهر شهر وسنة آخر تحديث في أعلى الصفحة.</p>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
